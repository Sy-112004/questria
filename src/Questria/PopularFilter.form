<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Questria.PopularFilter">
  <grid id="27dc6" binding="popularFilterPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="50" y="43" width="500" height="42"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="6dcf1" class="javax.swing.JComboBox" binding="popularFilterComboBox" custom-create="true">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-10902056"/>
          <font name="Fraunces 72pt Soft SemiBold" size="18" style="0"/>
          <foreground color="-16777216"/>
          <model>
            <item value="Filter"/>
            <item value="Top"/>
            <item value="Hot"/>
            <item value="Waiting For Reply"/>
          </model>
        </properties>
      </component>
      <hspacer id="98d34">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
    </children>
  </grid>
</form>

<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Questria.AboutHeader">
  <grid id="27dc6" binding="aboutHeaderPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <background color="-4797186"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="95919" class="javax.swing.JLabel" binding="aboutQuestriaLbl">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Fraunces 72pt" size="48" style="1"/>
          <foreground color="-16777216"/>
          <text value="About Questria"/>
        </properties>
      </component>
      <component id="1f593" class="javax.swing.JButton" binding="backBtn">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-4797186"/>
          <borderPainted value="false"/>
          <focusPainted value="false"/>
          <focusable value="false"/>
          <text value=""/>
        </properties>
      </component>
      <hspacer id="bab75">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
      </hspacer>
    </children>
  </grid>
</form>
